{
  "name": "famille-core",
  "version": "0.1.1",
  "description": "Socle commun du portail familial : Firebase, session, famille, thème. Aucune logique métier d'application.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "firebase": ">=11.0.0"
  },
  "devDependencies": {
    "firebase": "^13.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
